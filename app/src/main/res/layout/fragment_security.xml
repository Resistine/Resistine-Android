<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rs_surface"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/rs_screen_padding"
        android:paddingTop="@dimen/rs_space_16"
        android:paddingEnd="@dimen/rs_screen_padding"
        android:paddingBottom="@dimen/rs_space_32">

        <TextView
            style="@style/TextAppearance.Resistine.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/security_screen_title" />

        <TextView
            style="@style/TextAppearance.Resistine.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rs_space_8"
            android:text="@string/security_screen_subtitle" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Resistine.Card.Tinted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rs_space_20">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/rs_space_20">

                <ImageView
                    android:id="@+id/imageViewWazuhStatus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/background_home"
                    android:contentDescription="@string/security_endpoint_monitoring"
                    android:padding="@dimen/rs_space_10"
                    android:src="@drawable/shield_with_star"
                    app:tint="@color/rs_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/rs_space_16"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/TextAppearance.Resistine.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/security_endpoint_monitoring" />

                    <TextView
                        android:id="@+id/textViewWazuhStatus"
                        style="@style/TextAppearance.Resistine.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rs_space_4"
                        android:text="@string/security_agent_waiting" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Resistine.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rs_space_24"
            android:text="@string/security_network_identity" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Resistine.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rs_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/rs_space_20">

                <TextView
                    android:id="@+id/textViewIpAddress"
                    style="@style/TextAppearance.Resistine.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/security_ip_loading" />

                <TextView
                    android:id="@+id/textViewLocation"
                    style="@style/TextAppearance.Resistine.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rs_space_8"
                    android:text="@string/security_location_loading" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextAppearance.Resistine.Section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rs_space_24"
            android:text="@string/security_device_details" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Resistine.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rs_space_12">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/rs_space_20">

                <TextView
                    android:id="@+id/textViewDeviceModel"
                    style="@style/TextAppearance.Resistine.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/security_device_loading" />

                <TextView
                    android:id="@+id/textViewAndroidVersion"
                    style="@style/TextAppearance.Resistine.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rs_space_8"
                    android:text="@string/security_android_loading" />

                <TextView
                    android:id="@+id/textViewBatteryLevel"
                    style="@style/TextAppearance.Resistine.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rs_space_4"
                    android:text="@string/security_battery_loading" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonOpenVpn"
            style="@style/Widget.Resistine.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rs_space_20"
            android:text="@string/security_open_vpn" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

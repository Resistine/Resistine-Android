<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutTrustedNetworkRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_wifi_network_card"
    android:orientation="vertical"
    android:padding="12dp"
    android:elevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageViewTrustedNetworkIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/wifi_status_icon_safe_desc"
            android:src="@drawable/ic_wifi_status_safe" />

        <TextView
            android:id="@+id/textViewTrustedNetworkTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/wifi_trusted_entry_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewTrustedNetworkCurrentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_wifi_risk_safe"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="2dp"
            android:text="@string/wifi_network_current_short"
            android:textColor="@color/wifi_risk_safe_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/textViewTrustedNetworkBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/wifi_trusted_entry_body"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:id="@+id/scrollViewTrustedNetworkChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutTrustedNetworkChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layoutTrustedNetworkTechnicalDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    <TextView
        android:id="@+id/textViewTrustedNetworkIdentity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/wifi_network_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewTrustedNetworkInternet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_internet_access_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewTrustedNetworkProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_security_profile_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewTrustedNetworkBaseline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_trust_detail_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewTrustedNetworkSecurity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_security_type_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewTrustedNetworkStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_security_reason_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewTrustedNetworkTrust"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_trust_status_line_default"
        android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonRemoveTrustedNetwork"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/wifi_trust_remove_short" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rs_surface">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/rs_screen_padding">

            <ImageView
                android:id="@+id/shieldImage"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@drawable/background_home"
                android:contentDescription="@string/app_icon"
                android:padding="24dp"
                android:src="@drawable/resistine_shield" />

            <TextView
                android:id="@+id/otpTitle"
                style="@style/TextAppearance.Resistine.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rs_space_24"
                android:gravity="center"
                android:text="@string/verify_your_email" />

            <TextView
                android:id="@+id/otpSubtitle"
                style="@style/TextAppearance.Resistine.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rs_space_8"
                android:gravity="center"
                android:text="@string/otp_explanation" />

            <LinearLayout
                android:id="@+id/otpFieldsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rs_space_32"
                android:gravity="center"
                android:orientation="horizontal">
                <com.resistine.android.ui.login.OtpEditText android:id="@+id/otp1" style="@style/Widget.Resistine.OtpEditText" />
                <com.resistine.android.ui.login.OtpEditText android:id="@+id/otp2" style="@style/Widget.Resistine.OtpEditText" />
                <com.resistine.android.ui.login.OtpEditText android:id="@+id/otp3" style="@style/Widget.Resistine.OtpEditText" />
                <com.resistine.android.ui.login.OtpEditText android:id="@+id/otp4" style="@style/Widget.Resistine.OtpEditText" />
                <com.resistine.android.ui.login.OtpEditText android:id="@+id/otp5" style="@style/Widget.Resistine.OtpEditText" />
                <com.resistine.android.ui.login.OtpEditText android:id="@+id/otp6" style="@style/Widget.Resistine.OtpEditText" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/verifyOtpButton"
                style="@style/Widget.Resistine.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rs_space_32"
                android:text="@string/verify" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resendButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rs_space_8"
                android:text="@string/resend" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/changeEmailButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/change_email" />

            <TextView
                style="@style/TextAppearance.Resistine.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rs_space_24"
                android:text="@string/otp_expiry_note" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone" />
</FrameLayout>

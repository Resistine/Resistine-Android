<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rs_background"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/rs_toolbar_height"
        android:background="@color/rs_background"
        android:elevation="0dp"
        android:paddingStart="@dimen/rs_space_8"
        android:paddingEnd="@dimen/rs_space_8"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIconTint="@color/rs_primary"
        app:popupTheme="@style/Theme.ResistineAndroidApp.PopupOverlay"
        app:title="">

        <ImageView
            android:id="@+id/brandLogo"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/resistine_logo_description"
            android:scaleType="centerInside"
            android:src="@drawable/resistine_shield" />
    </com.google.android.material.appbar.MaterialToolbar>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_content_main"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:navGraph="@navigation/mobile_navigation" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        style="@style/Widget.Resistine.BottomNavigation"
        android:layout_width="0dp"
        android:layout_height="@dimen/rs_bottom_nav_height"
        android:layout_marginStart="@dimen/rs_space_12"
        android:layout_marginEnd="@dimen/rs_space_12"
        android:layout_marginBottom="@dimen/rs_space_8"
        android:background="@drawable/bg_bottom_navigation"
        android:paddingStart="@dimen/rs_space_4"
        android:paddingEnd="@dimen/rs_space_4"
        app:backgroundTint="@null"
        app:itemHorizontalTranslationEnabled="false"
        app:labelVisibilityMode="unlabeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/bottom_navigation" />

</androidx.constraintlayout.widget.ConstraintLayout>

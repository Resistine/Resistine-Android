<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutAvailableNetworkRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_wifi_network_card"
    android:orientation="vertical"
    android:padding="12dp"
    android:elevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imageViewAvailableNetworkIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/wifi_status_icon_warning_desc"
            android:src="@drawable/ic_wifi_status_warning" />

        <TextView
            android:id="@+id/textViewAvailableNetworkTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/wifi_security_title_info"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewAvailableNetworkCurrentBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_wifi_risk_safe"
            android:paddingLeft="8dp"
            android:paddingTop="2dp"
            android:paddingRight="8dp"
            android:paddingBottom="2dp"
            android:text="@string/wifi_network_current_short"
            android:textColor="@color/wifi_risk_safe_text"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/textViewAvailableNetworkBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/wifi_security_unavailable"
        android:textSize="13sp" />

    <HorizontalScrollView
        android:id="@+id/scrollViewAvailableNetworkChips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutAvailableNetworkChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/layoutAvailableNetworkTechnicalDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

    <TextView
        android:id="@+id/textViewAvailableNetworkIdentity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/wifi_network_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewAvailableNetworkInternet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_internet_access_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewAvailableNetworkProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_security_profile_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewAvailableNetworkConfidence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_match_confidence_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewAvailableNetworkSecurity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_security_type_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewAvailableNetworkStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_security_reason_line_default"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/textViewAvailableNetworkTrust"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/wifi_trust_status_line_default"
        android:textSize="12sp" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonToggleAvailableNetworkTrust"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/wifi_trust_add_short" />
</LinearLayout>

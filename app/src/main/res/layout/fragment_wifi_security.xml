<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewWifiHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_wifi_security"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewWifiSubheader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/wifi_security_screen_subheader"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/layoutWifiSafetyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/background_home"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/layoutCurrentWifiHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageViewWifiStatusIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@string/wifi_status_icon_warning_desc"
                    android:src="@drawable/ic_wifi_status_warning" />

                <TextView
                    android:id="@+id/textViewWifiSafetyTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/wifi_security_title_info"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewCurrentWifiToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_current_hide_details"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/textViewWifiSafetyScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_safety_score_default"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewScoreBreakdownTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_score_breakdown_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/scrollViewScoreBreakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutScoreBreakdownChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/textViewScoreBreakdownEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_score_breakdown_none"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textViewWifiSafetyBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/wifi_security_unavailable"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/layoutCurrentWifiDetailsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:id="@+id/textViewWifiNetworkIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/wifi_network_line_default"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textViewWifiInternetAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_internet_access_line_default"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textViewWifiSecurityType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_security_type_line_default"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textViewWifiSecurityReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_security_reason_line_default"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textViewWifiTrustStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_trust_status_line_default"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textViewWifiLastChecked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_security_last_checked_default"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textViewWifiRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_security_recommendation_info"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textViewAutoVpnTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/wifi_auto_vpn_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewAutoVpnPolicyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_auto_vpn_policy_off"
                android:textSize="12sp" />

            <Switch
                android:id="@+id/switchAutoVpnProtect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_auto_vpn_switch_protect" />

            <Switch
                android:id="@+id/switchAutoVpnDisconnectSafe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:enabled="false"
                android:text="@string/wifi_auto_vpn_switch_disconnect_safe" />

            <Button
                android:id="@+id/buttonAutoVpnDisconnectNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_auto_vpn_disconnect_now"
                android:visibility="gone" />

            <TextView
                android:id="@+id/textViewBackgroundScanTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/wifi_background_scan_title"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Switch
                android:id="@+id/switchBackgroundScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/wifi_background_scan_switch" />

            <TextView
                android:id="@+id/textViewBackgroundScanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_background_scan_status_default"
                android:textSize="12sp" />

            <Button
                android:id="@+id/buttonToggleTrustedWifi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/wifi_trust_add_button"
                android:visibility="gone" />

            <Button
                android:id="@+id/buttonGrantWifiPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/wifi_security_grant_permission"
                android:visibility="gone" />

            <Button
                android:id="@+id/buttonRefreshWifiSecurity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/network_scan_refresh" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAdvancedChecksHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewAdvancedChecksTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wifi_advanced_checks_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewAdvancedChecksToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_networks_show"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAdvancedChecksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutAvailableNetworksHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewAvailableNetworksTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wifi_available_networks_title_default"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewAvailableNetworksToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_networks_show"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutAvailableNetworksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutTrustedNetworksHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textViewTrustedNetworksTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/wifi_trusted_networks_title_default"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewTrustedNetworksToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/wifi_networks_show"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutTrustedNetworksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

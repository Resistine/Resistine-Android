<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rs_background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/rs_screen_padding"
        android:paddingTop="@dimen/rs_space_16"
        android:paddingEnd="@dimen/rs_screen_padding"
        android:paddingBottom="@dimen/rs_space_32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textViewWifiHeader"
                    style="@style/TextAppearance.Resistine.Headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_wifi_security" />

                <TextView
                    android:id="@+id/textViewWifiSubheader"
                    style="@style/TextAppearance.Resistine.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rs_space_4"
                    android:text="@string/wifi_security_screen_subheader_compact" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRefreshWifiQuick"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginStart="@dimen/rs_space_12"
                android:contentDescription="@string/network_scan_refresh"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:padding="14dp"
                app:backgroundTint="@color/rs_surface_blue"
                app:icon="@drawable/ic_refresh_24"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="24dp"
                app:iconTint="@color/rs_primary" />
        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/wifiRefreshProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rs_space_12"
            android:indeterminate="true"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutWifiSafetyCard"
            style="@style/Widget.Resistine.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rs_space_16">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/rs_space_20">

                <LinearLayout
                    android:id="@+id/layoutCurrentWifiHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imageViewWifiStatusIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/wifi_status_icon_warning_desc"
                        android:src="@drawable/ic_wifi_status_warning" />

                    <TextView
                        android:id="@+id/textViewWifiSafetyTitle"
                        style="@style/TextAppearance.Resistine.Section"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/rs_space_12"
                        android:layout_weight="1"
                        android:text="@string/wifi_security_title_info" />

                    <TextView
                        android:id="@+id/textViewCurrentWifiToggle"
                        style="@style/TextAppearance.Resistine.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_current_hide_details"
                        android:textColor="@color/rs_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textViewWifiSafetyScore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rs_space_16"
                    android:text="@string/wifi_safety_score_default"
                    android:textColor="@color/rs_text_primary"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textViewWifiSafetyBody"
                    style="@style/TextAppearance.Resistine.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rs_space_6"
                    android:text="@string/wifi_security_unavailable" />

                <HorizontalScrollView
                    android:id="@+id/scrollViewCurrentWifiSummaryChips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/rs_space_12"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutCurrentWifiSummaryChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/layoutCurrentWifiDetailsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/rs_space_16"
                        android:layout_marginBottom="@dimen/rs_space_12"
                        android:background="@color/rs_outline" />

                    <TextView android:id="@+id/textViewWifiNetworkIdentity" style="@style/TextAppearance.Resistine.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_network_line_default" />
                    <TextView android:id="@+id/textViewWifiSecurityReason" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_6" android:text="@string/wifi_security_reason_line_default" />
                    <TextView android:id="@+id/textViewWifiTrustDetail" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_4" android:text="@string/wifi_trust_detail_default" />

                    <TextView
                        android:id="@+id/textViewScoreBreakdownTitle"
                        style="@style/TextAppearance.Resistine.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rs_space_16"
                        android:text="@string/wifi_score_breakdown_title" />

                    <HorizontalScrollView
                        android:id="@+id/scrollViewScoreBreakdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rs_space_6"
                        android:scrollbars="none">
                        <LinearLayout android:id="@+id/layoutScoreBreakdownChips" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/textViewScoreBreakdownEmpty"
                        style="@style/TextAppearance.Resistine.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rs_space_4"
                        android:text="@string/wifi_score_breakdown_none"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchWifiDebugDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rs_space_12"
                        android:text="@string/wifi_debug_details_switch"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/textViewWifiDebugDetailsHint"
                        style="@style/TextAppearance.Resistine.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wifi_debug_details_hint"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutCurrentWifiTechnicalContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rs_space_8"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView android:id="@+id/textViewWifiInternetAccess" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_internet_access_line_default" />
                        <TextView android:id="@+id/textViewWifiSecurityProfile" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/wifi_security_profile_line_default" />
                        <TextView android:id="@+id/textViewWifiPmf" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/wifi_pmf_line_default" />
                        <TextView android:id="@+id/textViewWifiSecurityType" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/wifi_security_type_line_default" />
                        <TextView android:id="@+id/textViewWifiMatchConfidence" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/wifi_match_confidence_line_default" />
                        <TextView android:id="@+id/textViewWifiScanFreshness" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/wifi_scan_freshness_line_default" />
                        <TextView android:id="@+id/textViewWifiTrustStatus" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/wifi_trust_status_line_default" />
                        <TextView android:id="@+id/textViewWifiLastChecked" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/wifi_security_last_checked_default" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/textViewWifiRecommendation"
                        style="@style/TextAppearance.Resistine.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rs_space_12"
                        android:text="@string/wifi_security_recommendation_info" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonToggleTrustedWifi"
                        style="@style/Widget.Resistine.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rs_space_12"
                        android:text="@string/wifi_trust_add_button"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonGrantWifiPermission"
                        style="@style/Widget.Resistine.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rs_space_8"
                        android:text="@string/wifi_security_grant_permission"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Resistine.Card.Tinted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/rs_space_16">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/rs_space_20">
                <TextView style="@style/TextAppearance.Resistine.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_auto_vpn_title" />
                <TextView android:id="@+id/textViewAutoVpnPolicyStatus" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_4" android:text="@string/wifi_auto_vpn_policy_off" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchAutoVpnProtect" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_12" android:text="@string/wifi_auto_vpn_switch_protect" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchAutoVpnProtectUnknown" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_auto_vpn_switch_unknown" />
                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchAutoVpnDisconnectSafe" android:layout_width="match_parent" android:layout_height="wrap_content" android:enabled="false" android:text="@string/wifi_auto_vpn_switch_disconnect_safe" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonAutoVpnDisconnectNow" style="@style/Widget.Resistine.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_8" android:text="@string/wifi_auto_vpn_disconnect_now" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView style="@style/TextAppearance.Resistine.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_24" android:text="@string/wifi_explore_title" />

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Resistine.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_12">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/layoutAvailableNetworksHeader" android:layout_width="match_parent" android:layout_height="88dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/rs_space_20">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@null" android:src="@drawable/ic_menu_wifi" app:tint="@color/rs_primary" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/rs_space_12" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/textViewAvailableNetworksTitle" style="@style/TextAppearance.Resistine.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_available_networks_title_default" />
                        <TextView style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_2" android:text="@string/wifi_available_networks_subtitle" android:textSize="13sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/textViewAvailableNetworksToggle" style="@style/TextAppearance.Resistine.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wifi_networks_show" android:textColor="@color/rs_primary" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutAvailableNetworksContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/rs_space_16" android:paddingEnd="@dimen/rs_space_16" android:paddingBottom="@dimen/rs_space_16" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView style="@style/Widget.Resistine.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_12">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                <LinearLayout android:id="@+id/layoutTrustedNetworksHeader" android:layout_width="match_parent" android:layout_height="88dp" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="@dimen/rs_space_20">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@null" android:src="@drawable/resistine_shield" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/rs_space_12" android:layout_weight="1" android:orientation="vertical">
                        <TextView android:id="@+id/textViewTrustedNetworksTitle" style="@style/TextAppearance.Resistine.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/wifi_trusted_networks_title_default" />
                        <TextView style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_2" android:text="@string/wifi_trusted_networks_subtitle" android:textSize="13sp" />
                    </LinearLayout>
                    <TextView android:id="@+id/textViewTrustedNetworksToggle" style="@style/TextAppearance.Resistine.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/wifi_networks_show" android:textColor="@color/rs_primary" />
                </LinearLayout>
                <LinearLayout android:id="@+id/layoutTrustedNetworksContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="@dimen/rs_space_16" android:paddingEnd="@dimen/rs_space_16" android:paddingBottom="@dimen/rs_space_16" android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

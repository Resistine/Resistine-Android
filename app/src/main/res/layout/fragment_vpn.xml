<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewVpnHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_vpn"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewVpnSubheader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/vpn_screen_subheader"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/textViewVpnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:text="@string/vpn_status_disconnected"
            android:textSize="16sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchVpnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_vpn"
            android:textSize="18sp"
            android:paddingVertical="8dp" />

        <LinearLayout
            android:id="@+id/layoutRuntimeSelector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_wifi_network_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/textViewRuntimeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/vpn_runtime_status_default"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/layoutFlowWazuhSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/flow_wazuh_delivery_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/flow_wazuh_delivery_subtitle"
                    android:textSize="13sp" />

                <RadioGroup
                    android:id="@+id/radioGroupFlowWazuhDelivery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioFlowWazuhLocal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/flow_wazuh_local_only" />

                    <RadioButton
                        android:id="@+id/radioFlowWazuhRemote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/flow_wazuh_remote_manager" />
                </RadioGroup>

                <TextView
                    android:id="@+id/textViewFlowWazuhStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/flow_wazuh_local_status"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/layoutRemoteWazuhEndpoint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/flow_wazuh_manager_host">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editTextWazuhManagerHost"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:hint="@string/flow_wazuh_auth_port">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextWazuhAuthPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="5"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:hint="@string/flow_wazuh_log_port">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextWazuhLogPort"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:maxLength="5"
                                android:maxLines="1" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSaveWazuhEndpoint"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:text="@string/flow_wazuh_save_endpoint" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_wifi_network_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/SystemInformation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_horizontal"
                android:text="@string/system_information"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textViewIpAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/ip_address_loading"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/location_loading"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:id="@+id/textViewDeviceModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/device_model_loading"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewAndroidVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/android_version_loading"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewBatteryLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/battery_level_loading"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

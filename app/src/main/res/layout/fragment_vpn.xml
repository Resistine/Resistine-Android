<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/textViewVpnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/vpn_status_disconnected"
            android:textSize="18sp" />

        <Button
            android:id="@+id/buttonVpnToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect_vpn" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/background_home2"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageViewWifiSecurityIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@string/wifi_status_icon_warning_desc"
                    android:src="@drawable/ic_wifi_status_warning" />

                <TextView
                    android:id="@+id/textViewWifiSecurityTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/wifi_security_title_info"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/textViewWifiSecurityBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_security_unavailable"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textViewWifiSecurityType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/wifi_security_type_line_default"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textViewWifiSecurityReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_security_reason_line_default"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textViewWifiSecurityLastChecked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/wifi_security_last_checked_default"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textViewWifiSecurityRecommendation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/wifi_security_recommendation_info"
                android:textSize="13sp" />

            <Button
                android:id="@+id/buttonGrantWifiPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/wifi_security_grant_permission"
                android:visibility="gone" />

            <Button
                android:id="@+id/buttonRefreshNetworkScan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/network_scan_refresh" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/background_home"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/SystemInformation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:gravity="center_horizontal"
                android:text="@string/system_information"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/textViewIpAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/ip_address_loading"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textViewAndroidVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/android_version_loading"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textViewBatteryLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/battery_level_loading"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textViewDeviceModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/device_model_loading"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/textViewLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/location_loading"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

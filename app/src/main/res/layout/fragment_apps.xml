<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rs_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/rs_background"
        android:elevation="0dp"
        app:elevation="0dp">

        <LinearLayout
            android:id="@+id/appBarContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/rs_screen_padding"
            android:paddingTop="@dimen/rs_space_16"
            android:paddingEnd="@dimen/rs_screen_padding"
            app:layout_scrollFlags="scroll|enterAlways">

            <TextView
                style="@style/TextAppearance.Resistine.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/apps_screen_title" />

            <TextView
                style="@style/TextAppearance.Resistine.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rs_space_4"
                android:text="@string/apps_screen_subtitle_compact" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/scan_summary_card"
                style="@style/Widget.Resistine.Card.Tinted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rs_space_16">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/rs_space_16">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView android:id="@+id/scan_summary_title" style="@style/TextAppearance.Resistine.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/scan_summary_not_scanned" />
                            <TextView android:id="@+id/scan_summary_body" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_4" android:text="@string/scan_summary_prompt" />
                            <TextView android:id="@+id/scan_summary_time" style="@style/TextAppearance.Resistine.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_4" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_scan"
                            style="@style/Widget.Resistine.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/rs_space_12"
                            android:minWidth="120dp"
                            android:text="@string/scan_button" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/scan_progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/rs_space_8"
                        android:indeterminate="true"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/filters_container"
                style="@style/Widget.Resistine.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rs_space_12"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/rs_space_16">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <TextView style="@style/TextAppearance.Resistine.Section" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/filters_title" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_clear_filters" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="40dp" android:text="@string/filters_clear" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_done_filters" style="@style/Widget.Material3.Button.TonalButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/rs_space_4" android:minHeight="40dp" android:text="@string/filters_done" />
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/sort_input_layout" style="@style/Widget.Resistine.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/sort_by" app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/sort_dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:cursorVisible="false" android:focusable="false" android:gravity="center_vertical" android:inputType="none" android:minHeight="56dp" android:paddingStart="16dp" android:paddingEnd="48dp" android:singleLine="true" android:textAlignment="viewStart" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_system_apps" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_8" android:text="@string/show_system_apps" />

                    <TextView android:id="@+id/risk_filter_label" style="@style/TextAppearance.Resistine.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_12" android:text="@string/filter_risk_label" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/risk_chip_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_6" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="4dp" app:singleSelection="false">
                        <com.google.android.material.chip.Chip android:id="@+id/chip_risk_safe" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/app_verdict_no_concern" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_risk_warning" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/app_verdict_review" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_risk_risk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/app_verdict_urgent_review" />
                    </com.google.android.material.chip.ChipGroup>

                    <TextView android:id="@+id/badge_filter_label" style="@style/TextAppearance.Resistine.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_12" android:text="@string/filter_badge_label" />
                    <com.google.android.material.chip.ChipGroup android:id="@+id/badge_chip_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_6" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="4dp" app:singleSelection="false">
                        <com.google.android.material.chip.Chip android:id="@+id/chip_badge_accessibility" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/badge_accessibility_enabled" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_badge_device_admin" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/badge_device_admin" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_badge_notification_access" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/badge_notification_access" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_badge_local_install" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/badge_local_install" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_badge_debuggable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/badge_debuggable" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_badge_old_target_sdk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/badge_old_target_sdk" />
                        <com.google.android.material.chip.Chip android:id="@+id/chip_badge_high_risk_permission" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checkable="true" android:text="@string/badge_high_risk_permission" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/permission_actions_card"
                style="@style/Widget.Resistine.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/rs_space_12"
                android:visibility="gone">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/rs_space_16">
                    <TextView android:id="@+id/permission_actions_title" style="@style/TextAppearance.Resistine.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/permission_actions_title" />
                    <TextView android:id="@+id/permission_actions_body" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_4" android:text="@string/permission_actions_body" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/permission_action_input_layout" style="@style/Widget.Resistine.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_12" android:hint="@string/permission_actions_select_label" app:endIconMode="dropdown_menu">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/permission_action_dropdown" android:layout_width="match_parent" android:layout_height="wrap_content" android:cursorVisible="false" android:focusable="false" android:gravity="center_vertical" android:inputType="none" android:minHeight="56dp" android:paddingStart="16dp" android:paddingEnd="48dp" android:singleLine="true" android:textAlignment="viewStart" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_permission_manager" style="@style/Widget.Resistine.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_12" android:text="@string/permission_actions_open_manager" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/button_review_flagged_apps" style="@style/Widget.Resistine.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_8" android:text="@string/permission_actions_open_current" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_8" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_review_previous" style="@style/Widget.Resistine.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/permission_actions_previous" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/button_review_next" style="@style/Widget.Resistine.Button.Outlined" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/rs_space_8" android:layout_weight="1" android:text="@string/permission_actions_next" />
                    </LinearLayout>
                    <TextView android:id="@+id/permission_review_current_app" style="@style/TextAppearance.Resistine.Label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_12" android:text="@string/permission_actions_current_none" />
                    <TextView android:id="@+id/permission_review_status" style="@style/TextAppearance.Resistine.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/rs_space_4" android:text="@string/permission_actions_status_ready" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/rs_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/rs_screen_padding"
            android:paddingTop="@dimen/rs_space_12"
            android:paddingEnd="@dimen/rs_screen_padding"
            android:paddingBottom="@dimen/rs_space_12">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_input_layout"
                style="@style/Widget.Resistine.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/search_apps"
                app:startIconDrawable="@drawable/ic_search_24">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/search_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_toggle_filters"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/rs_space_8"
                android:contentDescription="@string/show_filters"
                android:insetLeft="0dp"
                android:insetTop="0dp"
                android:insetRight="0dp"
                android:insetBottom="0dp"
                android:text=""
                app:backgroundTint="@color/rs_surface_blue"
                app:icon="@drawable/ic_filter_24"
                app:iconTint="@color/rs_primary" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewApps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="@dimen/rs_screen_padding"
        android:paddingTop="@dimen/rs_space_8"
        android:paddingEnd="@dimen/rs_screen_padding"
        android:paddingBottom="@dimen/rs_space_24"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>

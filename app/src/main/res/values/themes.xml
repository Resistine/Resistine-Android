<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ResistineAndroidApp" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/rs_primary</item>
        <item name="colorOnPrimary">@color/rs_on_primary</item>
        <item name="colorPrimaryContainer">@color/rs_surface_blue</item>
        <item name="colorOnPrimaryContainer">@color/rs_text_primary</item>
        <item name="colorSecondary">@color/rs_primary_bright</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/rs_surface_blue</item>
        <item name="colorOnSecondaryContainer">@color/rs_primary_dark</item>
        <item name="colorTertiary">@color/rs_primary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/rs_surface_blue</item>
        <item name="colorOnTertiaryContainer">@color/rs_primary_dark</item>
        <item name="colorSurface">@color/rs_surface</item>
        <item name="colorOnSurface">@color/rs_text_primary</item>
        <item name="colorSurfaceVariant">@color/rs_surface_tinted</item>
        <item name="colorOnSurfaceVariant">@color/rs_text_secondary</item>
        <item name="colorOutline">@color/rs_outline</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/rs_background</item>
        <item name="android:navigationBarColor">@color/rs_background</item>
        <item name="android:windowBackground">@color/rs_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/rs_primary_bright</item>
        <item name="materialButtonStyle">@style/Widget.Resistine.Button.Primary</item>
        <item name="materialCardViewStyle">@style/Widget.Resistine.Card</item>
        <item name="textInputStyle">@style/Widget.Resistine.TextInputLayout</item>
        <item name="materialSwitchStyle">@style/Widget.Resistine.Switch</item>
    </style>

    <style name="Theme.ResistineAndroidApp.NoActionBar" parent="Theme.ResistineAndroidApp" />
    <style name="Theme.ResistineAndroidApp.AppBarOverlay" parent="ThemeOverlay.Material3.ActionBar" />
    <style name="Theme.ResistineAndroidApp.PopupOverlay" parent="ThemeOverlay.Material3.Light" />

    <style name="Widget.Resistine.OtpEditText" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/bg_otp_edittext</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/rs_text_primary</item>
    </style>
</resources>
